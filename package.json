{
  "name": "web-component-stencil-test",
  "version": "0.3.1",
  "description": "A small responsive grid, input, and button web component library built with Stencil.",
  "author": "Arnaud Tanielian",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danetag/web-component-stencil-test.git"
  },
  "bugs": {
    "url": "https://github.com/Danetag/web-component-stencil-test/issues"
  },
  "homepage": "https://github.com/Danetag/web-component-stencil-test#readme",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/test/test.esm.js",
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build --docs",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec",
    "test:watch": "stencil test --spec --watchAll",
    "test:e2e": "node scripts/stencil-e2e.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "generate": "stencil generate"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "devDependencies": {
    "@stencil/core": "^4.44.2",
    "@stencil/sass": "3.2.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "puppeteer": "^25.10.0",
    "typescript": "^5.9.3"
  }
}
